@page "/armies/{ArmyId:int}"
@using Model.Entities.Armies
@using Domain.Repositories.Interfaces
@inject IArmyRepository _repository;
@inject NavigationManager _manager;

@if (Army is not null)
{
    <div class="container">
        <h1 class="display-1">Armies</h1>
        <div class="card">
            <div class="card-body">
                <div class="card-title">
                    <h1 class="text-primary">@Army.Label</h1>
                </div>
                @if (Army.Meeples.Count > 0)
                {
                    <div class="card-body">
                        <table class="table table-striped table-sm">
                            <thead>
                            <tr>
                                <th>Meeple</th>
                                <th>Row</th>
                                <th>Column</th>
                                <th>Icon</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var meeple in Army.Meeples)
                            {
                                <tr>
                                    <td>look at code</td> <!-- i would use meeple.Label, there is no label, I think not implemented -->
                                    <td>@meeple.X</td>
                                    <td>@meeple.Y</td>
                                    <td><img src="@meeple.Url"/></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <a class="btn btn-primary" href="">Abbrechen</a>
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <span>Loading...</span>
}

@code {
    [Parameter]
    public int ArmyId { get; set; }

    public Army Army { get; set; }

    protected async override Task OnParametersSetAsync()
    {
        Army = await _repository.ReadGraphAsync(ArmyId);
    }

    protected void Abandon()
    {
        _manager.NavigateTo("/");
    }

}